# ================================
# AI SaaS Backend Environment Variables
# ================================

# Server
NODE_ENV=development
PORT=5000

# ================================
# DATABASE (PostgreSQL via Docker)
# ================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_saas_db?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_saas_db

# ================================
# JWT
# ================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRES_IN=30d

# ================================
# ENCRYPTION (for OAuth tokens)
# AES-256 key — must be exactly 32 characters
# ================================
ENCRYPTION_KEY=your_32_char_encryption_key_here!!

# ================================
# GOOGLE OAUTH 2.0
# Get from: https://console.cloud.google.com
# Create Project → APIs & Services → Credentials → OAuth 2.0 Client ID
# Enable: Gmail, Calendar, Drive, Docs, Sheets APIs
# ================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ================================
# OPENAI
# Get from: https://platform.openai.com/api-keys
# ================================
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# ================================
# RAZORPAY
# Get from: https://dashboard.razorpay.com/app/keys
# ================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Subscription Plan IDs (create in Razorpay Dashboard)
RAZORPAY_FREE_PLAN_ID=plan_free
RAZORPAY_PRO_PLAN_ID=plan_your_pro_plan_id

# ================================
# TWILIO (WhatsApp)
# Get from: https://console.twilio.com
# Use Twilio Sandbox for WhatsApp testing
# ================================
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ================================
# FRONTEND
# ================================
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
